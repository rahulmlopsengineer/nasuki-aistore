+std::vector<int> llama_rn_context::getWorkerTids() const {
+    std::vector<int> tids;
+
+    auto add_tids_from_tp = [&tids](lm_ggml_threadpool * tp) {
+        if (tp == nullptr) return;
+        int n = lm_ggml_threadpool_get_n_threads(tp);
+        for (int i = 0; i < n; i++) {
+            int tid = lm_ggml_threadpool_get_worker_tid(tp, i);
+            if (tid > 0) {
+                bool exists = false;
+                for (int existing : tids) {
+                    if (existing == tid) {
+                        exists = true;
+                        break;
+                    }
+                }
+                if (!exists) {
+                    tids.push_back(tid);
+                }
+            }
+        }
+    };
+
+    add_tids_from_tp(threadpool);
+    add_tids_from_tp(threadpool_batch);
+
+    return tids;
+}
+
 }
