+# JNI wrapper source files (always build from source)
+set(JNI_SOURCE_FILES
+    ${CMAKE_SOURCE_DIR}/RNLlamaJSI.cpp
+    ${CMAKE_SOURCE_DIR}/../../../cpp/jsi/RNLlamaJSI.cpp
+    ${CMAKE_SOURCE_DIR}/../../../cpp/jsi/JSIContext.cpp
