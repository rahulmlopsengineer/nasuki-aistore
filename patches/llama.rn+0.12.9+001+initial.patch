+#if defined(__ANDROID__)
+#include <android/performance_hint.h>
+#include <dlfcn.h>
+
+namespace rnllama {
+// ADPF dynamic loader
+struct ADPF {
+    typedef APerformanceHintManager* (*getManagerFn)();
+    typedef APerformanceHintSession* (*createSessionFn)(APerformanceHintManager*, const int32_t*, size_t, int64_t);
+    typedef void (*reportActualWorkDurationFn)(APerformanceHintSession*, int64_t);
+    typedef void (*closeSessionFn)(APerformanceHintSession*);
+
+    getManagerFn getManager = nullptr;
+    createSessionFn createSession = nullptr;
+    reportActualWorkDurationFn reportActualWorkDuration = nullptr;
+    closeSessionFn closeSession = nullptr;
+
+    APerformanceHintManager* manager = nullptr;
+    APerformanceHintSession* session = nullptr;
+
+    ADPF() {
+        void* handle = dlopen("libandroid.so", RTLD_NOW);
+        if (handle) {
+            getManager = (getManagerFn)dlsym(handle, "APerformanceHintManager_getManager");
+            createSession = (createSessionFn)dlsym(handle, "APerformanceHintManager_createSession");
+            reportActualWorkDuration = (reportActualWorkDurationFn)dlsym(handle, "APerformanceHintSession_reportActualWorkDuration");
+            closeSession = (closeSessionFn)dlsym(handle, "APerformanceHintSession_close");
+
+            if (getManager) {
+                manager = getManager();
+            }
+        }
+    }
+
+    void startSession(const std::vector<int>& tids, int64_t targetDurationNanos) {
+        if (!manager || !createSession || tids.empty()) return;
+        if (session && closeSession) {
+            closeSession(session);
+        }
+        std::vector<int32_t> tids32(tids.begin(), tids.end());
+        session = createSession(manager, tids32.data(), tids32.size(), targetDurationNanos);
+    }
+
+    void reportDuration(int64_t actualNanos) {
+        if (session && reportActualWorkDuration) {
+            reportActualWorkDuration(session, actualNanos);
+        }
+    }
+
+    ~ADPF() {
+        if (session && closeSession) {
+            closeSession(session);
+        }
+    }
+};
+}
+#endif
